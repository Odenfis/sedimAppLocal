# Server Configuration
PORT=3000
SESSION_SECRET=cambiame_por_algo_seguro

# Database Configuration
DB_USER=tu_usuario
DB_PASS=tu_password
DB_SERVER=tu_servidor_o_ip
DB_NAME=tu_base_de_datos

# Fase 23 - 3nStar RPT004 por Ethernet. Mantener deshabilitada hasta validar IP y ticket físico.
PRINTER_ENABLED=false
PRINTER_HOST=
PRINTER_PROTOCOL=escpos_tcp
PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=5000
PRINTER_CODEPAGE=cp850
PRINTER_CUT=true

# Fase 24 - cierre y retencion de turnos. Genere el hash con bcrypt (nunca guarde el PIN aqui).
MAINTENANCE_PIN_HASH=
KITCHEN_RETENTION_DAYS=30
KITCHEN_RETENTION_INTERVAL_MS=21600000
